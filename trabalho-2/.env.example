# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e NUNCA vai para o repositório.

# Provedor de LLM e chave de API (um só provedor, definido no dia 1)
# LLM_PROVIDER: openai | ollama
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=
# Opcional. Para Ollama, o padrão é http://localhost:11434/v1
LLM_BASE_URL=

# Vazio usa o servidor MCP deste repositório via stdio.
MCP_URL=
# Opcional para que /healthz da API também verifique um MCP remoto.
MCP_HEALTH_URL=
# Valores vazios usam data/chroma e o modelo multilíngue padrão.
CHROMA_PATH=
EMBEDDING_MODEL=

# Avaliação RAGAS. Omitir base URL e chave reutiliza as configurações do LLM.
RAGAS_MODEL=
RAGAS_BASE_URL=
RAGAS_API_KEY=
RAGAS_RACIOCINIO=

# Caminho do binário do Stockfish (não versionado; baixe de https://stockfishchess.org/download/)
STOCKFISH_PATH=

# User-Agent exigido pela API pública do Chess.com (nome do app + contato), ex.:
# "lance-a-lance/0.1 (contato: email@exemplo.com)"
CHESSCOM_USER_AGENT=

# API e persistência local. No Compose os caminhos internos já estão definidos.
SQLITE_PATH=
PUZZLES_DB=
CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PORT=8000
# Perfil interativo MCP padrão permanece profundidade 18 e MultiPV 3.
ANALISE_PROFUNDIDADE=12
# Incremente ao trocar a versão do motor para invalidar a análise persistida.
ANALISE_REVISAO_MOTOR=1
LLM_TEMPERATURA=0
# Para Qwen3 local, "none" desativa o raciocínio prolongado.
LLM_RACIOCINIO=
LLM_MAX_TOKENS=
LLM_TIMEOUT=25
LLM_JSON_MODE=0
# Incremente ao trocar o modelo sob o mesmo nome para invalidar suas explicações.
LLM_REVISAO=
