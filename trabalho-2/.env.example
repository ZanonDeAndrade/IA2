# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e NUNCA vai para o repositório.

# Provedor de LLM e chave de API (um só provedor, definido no dia 1)
# Valores previstos para LLM_PROVIDER: anthropic | openai | gemini | ollama
LLM_API_KEY=
LLM_PROVIDER=

# Caminho do binário do Stockfish (não versionado; baixe de https://stockfishchess.org/download/)
STOCKFISH_PATH=

# User-Agent exigido pela API pública do Chess.com (nome do app + contato), ex.:
# "lance-a-lance/0.1 (contato: email@exemplo.com)"
CHESSCOM_USER_AGENT=
