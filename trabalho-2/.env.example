# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e NUNCA vai para o repositório.

# Provedor de LLM e chave de API (um só provedor, definido no dia 1)
# Valores previstos para LLM_PROVIDER: anthropic | openai | gemini | ollama
LLM_API_KEY=
LLM_PROVIDER=

# Caminho do binário do Stockfish (não versionado; baixe de https://stockfishchess.org/download/
# ou instale com brew/apt). Vazio = procura "stockfish" no PATH. No Docker já vem instalado.
STOCKFISH_PATH=
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
# analisar_posicao: tempo máximo por posição (s)
TEMPO_MAX_POSICAO=1.5
# analisar_partida: profundidade e tempo por posição (40 lances em < 60 s)
PROFUNDIDADE_PARTIDA=14
TEMPO_POR_LANCE=0.4

# User-Agent exigido pela API pública do Chess.com (nome do app + contato), ex.:
# "lance-a-lance/0.1 (contato: email@exemplo.com)"
CHESSCOM_USER_AGENT=

# Servidor MCP: stdio (padrão) ou http. No Docker o compose usa http na porta 8001.
MCP_TRANSPORT=stdio
MCP_PORT=8001
# URL que o backend usa para falar com o MCP. Vazio = servidor no mesmo processo.
MCP_URL=

# Backend
CORS_ORIGINS=http://localhost:5173
# Caminhos (padrão: dentro de data/ e logs/)
# DB_PATH=data/lance_a_lance.sqlite
# PUZZLES_DB=data/puzzles.sqlite
# CACHE_DIR=data/cache
# LOG_DIR=logs
LOG_LEVEL=INFO
